# Copia este archivo a .env y completa los valores desde
# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Solo para scripts/Edge Functions en servidor. NUNCA usar con prefijo EXPO_PUBLIC_
# ni importarla desde la app: daría acceso total saltándose RLS.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Sprint 4 · Cuenta para los abonos por transferencia (se muestra al cliente en su reserva).
# Ejemplo: Bancolombia · Cuenta de ahorros 000-000000-00 · GOLDTRANS S.A.S. · NIT 900000000-0
EXPO_PUBLIC_DATOS_TRANSFERENCIA=
